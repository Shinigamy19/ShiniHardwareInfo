<Window x:Class="ShiniHardwareInfo.Widget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ShiniHardwareInfo.Widget"
        Title="ShiniHardwareInfo"
        Height="200" Width="340"
        MinHeight="120" MinWidth="280"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        Topmost="True" ShowInTaskbar="False"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="CanResizeWithGrip"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        SizeChanged="Window_SizeChanged"
        Closing="Window_Closing">
    <Window.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <local:InvertedBoolToVisibilityConverter x:Key="InvBoolToVis"/>
    </Window.Resources>
    <Border x:Name="RootBorder" CornerRadius="12" Background="#CC1E1E2E" BorderBrush="#44FFFFFF" BorderThickness="1" Padding="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,6">
                <TextBlock Text="ShiniHardwareInfo" Foreground="#888" FontSize="10" VerticalAlignment="Center"/>
                <Button x:Name="SettingsButton" Content="⚙" HorizontalAlignment="Right" Width="22" Height="22"
                        Background="Transparent" Foreground="#AAA" BorderThickness="0" Cursor="Hand"
                        Click="SettingsButton_Click"/>
            </Grid>
            <StackPanel Grid.Row="1">
                <!-- RAM -->
                <Grid Margin="0,0,0,6" Visibility="{Binding ShowRam, Source={StaticResource Settings}, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="RAM" Foreground="#7CC" FontWeight="Bold" VerticalAlignment="Center"/>
                    <ProgressBar Grid.Column="1" Height="8" Minimum="0" Maximum="100" Margin="4,0" VerticalAlignment="Center"
                                 Value="{Binding RamLoad, Mode=OneWay}"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="6,0,0,0">
                        <TextBlock Foreground="White" FontSize="11" Text="{Binding RamLoad, StringFormat={}{0:F0}%}"/>
                        <TextBlock Foreground="#AAA" FontSize="10" Margin="4,0,0,0" Text="{Binding RamUsed, StringFormat={}{0:F1}GB}"/>
                    </StackPanel>
                </Grid>
                <!-- RAM extendida -->
                <StackPanel Margin="44,0,0,6" Visibility="{Binding ShowRamExtended, Source={StaticResource Settings}, Converter={StaticResource BoolToVis}}">
                    <TextBlock Foreground="#888" FontSize="9" Text="{Binding RamUsed, StringFormat={}Usado: {0:F2} GB}"/>
                    <TextBlock Foreground="#888" FontSize="9" Text="{Binding RamAvailable, StringFormat={}Libre: {0:F2} GB}"/>
                    <TextBlock Foreground="#888" FontSize="9" Text="{Binding RamTotal, StringFormat={}Total: {0:F2} GB}"/>
                </StackPanel>
                <!-- Discos -->
                <StackPanel Margin="0,0,0,6" Visibility="{Binding ShowDisks, Source={StaticResource Settings}, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding Disks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="DISK" Foreground="#CA8" FontWeight="Bold" FontSize="10" VerticalAlignment="Center"/>
                                    <ProgressBar Grid.Column="1" Height="8" Minimum="0" Maximum="100" Margin="4,0" VerticalAlignment="Center"
                                                 Value="{Binding LoadPercent, Mode=OneWay}"/>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="6,0,0,0">
                                        <TextBlock Foreground="White" FontSize="10" Text="{Binding Name}"/>
                                        <TextBlock Foreground="#AAA" FontSize="9" Margin="4,0,0,0" Text="{Binding UsedGb, StringFormat={} {0:F1}/}"/>
                                        <TextBlock Foreground="#AAA" FontSize="9" Text="{Binding TotalGb, StringFormat={}{0:F1}GB}"/>
                                        <TextBlock Foreground="#AAA" FontSize="9" Margin="4,0,0,0" Text="{Binding FreeGb, StringFormat={} (libre {0:F1})}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <!-- CPU -->
                <Grid Margin="0,0,0,6" Visibility="{Binding ShowCpu, Source={StaticResource Settings}, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="CPU" Foreground="#7C7" FontWeight="Bold" VerticalAlignment="Center"/>
                    <ProgressBar Grid.Column="1" Height="8" Minimum="0" Maximum="100" Margin="4,0" VerticalAlignment="Center"
                                 Value="{Binding CpuLoad, Mode=OneWay}"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="6,0,0,0">
                        <TextBlock Foreground="White" FontSize="11" Text="{Binding CpuLoad, StringFormat={}{0:F0}%}"/>
                        <TextBlock Foreground="#AAA" FontSize="10" Margin="4,0,0,0" Text="{Binding CpuTemp, StringFormat={} {0:F0}°C}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding ShowCpuTemp, Source={StaticResource Settings}}" Value="True"/>
                                                <Condition Binding="{Binding HasCpuTemp}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Foreground="#666" FontSize="10" Margin="4,0,0,0" Text="n/a">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding ShowCpuTemp, Source={StaticResource Settings}}" Value="True"/>
                                                <Condition Binding="{Binding HasCpuTemp}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Foreground="#AAA" FontSize="10" Margin="4,0,0,0" Text="{Binding CpuClock, StringFormat={} {0:F0}MHz}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding ShowCpuClock, Source={StaticResource Settings}}" Value="True"/>
                                                <Condition Binding="{Binding HasCpuClock}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Foreground="#666" FontSize="10" Margin="4,0,0,0" Text="n/a">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding ShowCpuClock, Source={StaticResource Settings}}" Value="True"/>
                                                <Condition Binding="{Binding HasCpuClock}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Foreground="#AAA" FontSize="10" Margin="4,0,0,0"
                                   Visibility="{Binding ShowCpuVoltage, Source={StaticResource Settings}, Converter={StaticResource BoolToVis}}"
                                   Text="{Binding CpuVoltage, StringFormat={} {0:F2}V}"/>
                    </StackPanel>
                </Grid>
                <!-- CPU name -->
                <TextBlock Foreground="#555" FontSize="9" Margin="44,0,0,6"
                           Visibility="{Binding ShowNames, Source={StaticResource Settings}, Converter={StaticResource BoolToVis}}"
                           Text="{Binding CpuName}"/>
                <!-- GPU -->
                <Grid Margin="0,0,0,6" Visibility="{Binding ShowGpu, Source={StaticResource Settings}, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="GPU" Foreground="#C77" FontWeight="Bold" VerticalAlignment="Center"/>
                    <ProgressBar Grid.Column="1" Height="8" Minimum="0" Maximum="100" Margin="4,0" VerticalAlignment="Center"
                                 Value="{Binding GpuLoad, Mode=OneWay}"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="6,0,0,0">
                        <TextBlock Foreground="White" FontSize="11" Text="{Binding GpuLoad, StringFormat={}{0:F0}%}"/>
                        <TextBlock Foreground="#AAA" FontSize="10" Margin="4,0,0,0" Text="{Binding GpuTemp, StringFormat={} {0:F0}°C}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding ShowGpuTemp, Source={StaticResource Settings}}" Value="True"/>
                                                <Condition Binding="{Binding HasGpuTemp}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Foreground="#666" FontSize="10" Margin="4,0,0,0" Text="n/a">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding ShowGpuTemp, Source={StaticResource Settings}}" Value="True"/>
                                                <Condition Binding="{Binding HasGpuTemp}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Foreground="#AAA" FontSize="10" Margin="4,0,0,0" Text="{Binding GpuClock, StringFormat={} {0:F0}MHz}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding ShowGpuClock, Source={StaticResource Settings}}" Value="True"/>
                                                <Condition Binding="{Binding HasGpuClock}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Foreground="#666" FontSize="10" Margin="4,0,0,0" Text="n/a">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding ShowGpuClock, Source={StaticResource Settings}}" Value="True"/>
                                                <Condition Binding="{Binding HasGpuClock}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Foreground="#AAA" FontSize="10" Margin="4,0,0,0"
                                   Visibility="{Binding ShowGpuVoltage, Source={StaticResource Settings}, Converter={StaticResource BoolToVis}}"
                                   Text="{Binding GpuVoltage, StringFormat={} {0:F2}V}"/>
                        <TextBlock Foreground="#AAA" FontSize="10" Margin="4,0,0,0"
                                   Visibility="{Binding ShowGpuMemory, Source={StaticResource Settings}, Converter={StaticResource BoolToVis}}"
                                   Text="{Binding GpuMemUsed, StringFormat={} {0:F0}/}"/>
                        <TextBlock Foreground="#AAA" FontSize="10"
                                   Visibility="{Binding ShowGpuMemory, Source={StaticResource Settings}, Converter={StaticResource BoolToVis}}"
                                   Text="{Binding GpuMemTotal, StringFormat={}{0:F0}MB}"/>
                    </StackPanel>
                </Grid>
                <!-- GPU name -->
                <TextBlock Foreground="#555" FontSize="9" Margin="44,0,0,0"
                           Visibility="{Binding ShowNames, Source={StaticResource Settings}, Converter={StaticResource BoolToVis}}"
                           Text="{Binding GpuName}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>